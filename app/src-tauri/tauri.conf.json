{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chriz's BG Collection",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.chrizhermann.bgcollection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Chriz's BG Collection",
        "width": 960,
        "height": 700,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
