{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chriz Easy BG",
  "version": "0.1.0-alpha.2",
  "identifier": "dev.chrizhermann.bgcollection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Chriz Easy BG",
        "width": 1160,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../manifest/": "manifest/",
      "../../recipes/creator-full-current/": "recipes/creator-full-current/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEODNEMkNGOUVCQkJDRDkKUldUWnZMdWV6OUtEN2Y1SGNJclkyRCtTYysvSXBhMEZJbW5PbnJQMWpDZGdlNjMrd0dyVG01VGkK",
      "endpoints": ["https://github.com/Chrizhermann/chriz-easy-bg/releases/download/alpha/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
