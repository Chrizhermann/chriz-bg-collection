BACKUP ~testmod/backup~
AUTHOR ~chriz-bg-collection integration tests~
VERSION ~v1.0.0-test~

LANGUAGE ~English~ ~english~ ~testmod/english/setup.tra~

BEGIN ~Copy an existing BIFF resource~
DESIGNATED 0

COPY_EXISTING ~spell.ids~ ~override/tmcopy.ids~

BEGIN ~Record setup-name mod folder~
DESIGNATED 10

COPY ~testmod/mod-folder.txt~ ~override/tmfolder.txt~
  EVALUATE_BUFFER

BEGIN ~Answer one authored prompt~
DESIGNATED 20

PRINT ~TESTMOD_PROMPT: type alpha~
ACTION_READLN testmod_answer
COPY ~testmod/prompt-result.txt~ ~override/tmprompt.txt~
  EVALUATE_BUFFER

BEGIN ~Fail after publishing a file~
DESIGNATED 30

COPY ~testmod/failure.txt~ ~override/tmfail.txt~
FAIL ~TESTMOD_CONTROLLED_FAILURE~

BEGIN ~Wait at an unauthored prompt~
DESIGNATED 40

PRINT ~TESTMOD_UNEXPECTED_PROMPT: type beta~
ACTION_READLN testmod_unexpected_answer
COPY ~testmod/unexpected-result.txt~ ~override/tmunexpected.txt~
  EVALUATE_BUFFER

BEGIN ~Accept an EET-style staged BG1 path~
DESIGNATED 50

OUTER_SPRINT testmod_bg1_dir ~%argv[1]%~
OUTER_PATCH_SAVE testmod_bg1_dir ~%testmod_bg1_dir%~ BEGIN
  REPLACE_TEXTUALLY ~[*?"<>|]~ ~~
  REPLACE_TEXTUALLY ~\\~ ~/~
END
ACTION_IF FILE_EXISTS ~%testmod_bg1_dir%/movies/sodcin05.wbm~ BEGIN
  COPY ~testmod/path-result.txt~ ~override/tmpathok.txt~
END ELSE BEGIN
  FAIL ~TESTMOD_EET_PATH_SENTINEL_MISSING~
END

BEGIN ~Run a bare batch name from the game folder~
DESIGNATED 60

// Like EET's desktop shortcut: place a batch file in the game folder and run it by bare name.
<<<<<<<< .../testmod-inlined/tmbare.bat
@echo off
echo bare batch ran>testmod\bare-result.txt
>>>>>>>>
COPY + ~.../testmod-inlined/tmbare.bat~ ~tmbare.bat~
AT_NOW ~tmbare.bat~
DELETE + ~tmbare.bat~
COPY ~testmod/bare-result.txt~ ~override/tmbare.txt~
